<Window x:Class="DualLlmPortal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DualLLM Portal" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0E0F12" Foreground="#F3F4F6"
        MinHeight="500" MinWidth="800">

    <Window.Resources>
        <!-- Modern Scrollbar Styling -->
        <Style x:Key="ModernScrollViewer" TargetType="{x:Type ScrollViewer}">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- Rounded ListBoxItem Styling -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border" 
                                Background="#1A1C23" 
                                BorderBrush="#2A2E3D" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="true">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Border" Property="Background" Value="#252834"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Border" Property="Background" Value="#1E3A8A"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 1. SETUP PAGE — the whole configuration surface is now an HTML page hosted in a
             WebView2 (see setup.html). SetupWebView is created in code-behind and dropped into
             this grid; a JS<->C# bridge feeds the existing scan/estimate/launch backend. -->
        <Grid x:Name="SetupPanel" Visibility="Visible">
            <Grid x:Name="SetupWebViewGrid"/>
        </Grid>

        <!-- 2. LOADING OVERLAY -->
        <Grid x:Name="LoadingPanel" Visibility="Collapsed" Background="#D80E0F12">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar x:Name="LoadingProgress" IsIndeterminate="True" Width="200" Height="4" BorderThickness="0" Background="#1F2937" Foreground="#3B82F6" Margin="0,0,0,20"/>
                <TextBlock x:Name="LoadingStatus" Text="Initializing local and remote servers..." FontSize="16" Foreground="#F3F4F6" HorizontalAlignment="Center"/>
                <TextBlock Text="Weights for remote devices are pushed over the network, which takes a while for a large model." FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 3. WEB CHAT PANEL -->
        <Grid x:Name="ChatPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" Background="#111318" BorderBrush="#222530" BorderThickness="0,0,0,1" Padding="15,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0"/>
                        <TextBlock x:Name="RunningModelTitle" Text="Model" FontSize="14" FontWeight="SemiBold" Foreground="#F3F4F6"/>
                        <TextBlock Text="" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" x:Name="ClusterStatusLabel"/>
                        <Ellipse x:Name="McpStatusDot" Width="8" Height="8" Fill="#F59E0B" Margin="12,0,8,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="McpStatusLabel" Text="MCP" FontSize="12" Foreground="#F59E0B" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" Content="Stop &amp; Change Model" 
                            Click="StopBtn_Click"
                            Background="#DC2626" Foreground="White" FontWeight="Bold" FontSize="11"
                            Padding="12,6" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- WebView2 embedded browser placeholder -->
            <Grid Grid.Row="1" x:Name="ChatWebViewGrid"/>
        </Grid>
    </Grid>
</Window>
